# FADE environment configuration.
# Copy to .env (cp .env.example .env) before running `make up`.
# Every variable below is consumed by docker compose interpolation and/or
# passed into the decision-api process (see README for documentation).

# --- PostgreSQL (state store) -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fade
POSTGRES_USER=fade
POSTGRES_PASSWORD=change-me

# --- Redis (feature/state cache) ----------------------------------------
REDIS_ADDR=redis:6379

# --- Redpanda / Kafka (event stream) ------------------------------------
KAFKA_BROKERS=redpanda:9092

# --- decision-api HTTP ---------------------------------------------------
HTTP_ADDR=:8080

# --- Logging (debug|info|warn|error) ------------------------------------
LOG_LEVEL=info

# --- ML scorer base URL --------------------------------------------------
ML_SCORER_URL=http://ml-scorer:8000

# --- Auth signing secret (change in any real deployment) ----------------
JWT_SECRET=change-me
